# License signing key material must NEVER be committed (see scripts/license_tool.py) — the
# default path is outside this repo entirely (~/.lawfirmagent_keys/), but these patterns are
# defense-in-depth in case that default is ever overridden to a repo-local path.
license_signing_key*
*license_signing_key*
license.token
license_clock_state.json

# Python virtualenvs (large, machine-specific, already excluded from the repos this was cloned
# from in spirit — each has its own .venv built locally).
.venv/
__pycache__/
*.pyc

# Electron build tooling (portable Node install + node_modules — large, machine-specific).
electron/node_modules/
.tools/

# Bundled installer binaries (Ollama + the PyInstaller-frozen backend, see scripts/build_backend.py
# and DESKTOP_PACKAGING.md) — several hundred MB, platform-specific build output, regenerated by
# build scripts rather than hand-edited. Distribute these as GitHub Release assets, not git commits.
electron/vendor/
electron/dist/

# Local runtime artifacts.
*.log

# macOS Finder metadata.
.DS_Store

# Preliminary patent/FTO research — not for the public repo until the user decides otherwise.
PATENT_RESEARCH.md
