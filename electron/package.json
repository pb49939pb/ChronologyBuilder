{
  "name": "lawfirmagent-desktop",
  "version": "0.0.9",
  "description": "Desktop shell for Chronology Builder",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node scripts/predist.js",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.lawfirmagent.desktop",
    "productName": "Chronology Builder",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "applog.js",
      "icon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "pb49939pb",
      "repo": "ChronologyBuilder"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.icns",
      "extraResources": [
        {
          "from": "vendor/ollama-mac",
          "to": "ollama-mac"
        },
        {
          "from": "vendor/backend-mac",
          "to": "backend-mac"
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "extraResources": [
        {
          "from": "vendor/ollama-win",
          "to": "ollama-win"
        },
        {
          "from": "vendor/backend-win",
          "to": "backend-win"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
